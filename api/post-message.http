###
# SCENARIO OUTLINE: Notifies an order is received.
#
# GIVEN a customer places an order
#  WHEN the POS records the order successfully
#  THEN a message is send to notify subscribers
###

# Verifies the Mock Server is running.
POST https://{{$dotenv HOST}}/v1/kitchen/messaging/ingress HTTP/1.1
Content-Type: application/json
X-API-KEY: {{$dotenv HOST_API_KEY}}

<@ ./sample-order.json

###

# Obtains an access token from Cognito to post messages.
# @name authz
POST https://skol.auth.us-east-1.amazoncognito.com/oauth2/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded
# Authorization: Basic {{$dotenv SAMPLE_CLIENT_ID}} {{$dotenv SAMPLE_CLIENT_SECRET}}

grant_type=client_credentials
&scope=kitchensync/post
&client_id={{$dotenv SAMPLE_CLIENT_ID}}
&client_secret={{$dotenv SAMPLE_CLIENT_SECRET}}

###

# Posts message directly to a custom event bus
# that enqueues the message in a queue
# then dequeues and routes to the mock server.
POST https://{{$dotenv APIGATEWAY}}/v1/ingress/events HTTP/1.1
Content-Type: application/json
Authorization: {{authz.response.body.token_type}} {{authz.response.body.access_token}}
X-SOURCE: doordash
X-EVENT-KIND: Order.Notification
X-ENVIRONMENT: Sandbox

<@ ./sample-order.json

###

# Posts message to an s3 bucket using a lambda function
# which triggers an event to the default event bus
# that puts the message in a queue
# then dequeues and routes to the mock server.
POST https://{{$dotenv APIGATEWAY}}/v2/ingress/events HTTP/1.1
Content-Type: application/json
Authorization: {{authz.response.body.token_type}} {{authz.response.body.access_token}}
X-SOURCE: Doordash
X-EVENT-KIND: Order.Notification
X-ENVIRONMENT: Sandbox

<@ ./sample-order.json
